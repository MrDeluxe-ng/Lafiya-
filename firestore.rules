rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches auth.uid)
    // Fields:
    //   - uid: string (required)
    //   - name: string (required, < 100 chars)
    //   - role: string (required, 'health_worker', 'parent', 'admin')
    //   - location: string (required, < 100 chars)
    //   - state: string (required, < 100 chars)
    //   - lga: string (required, < 100 chars)
    //   - ward: string (required, < 100 chars)
    //   - createdAt: timestamp (required)
    //
    // Collection: cases
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required, matches auth.uid)
    //   - patientAgeMonths: number (required, >= 0)
    //   - symptoms: string (required, < 1000 chars)
    //   - riskLevel: string (required, 'Low', 'Medium', 'High')
    //   - likelyIllness: string (required, < 200 chars)
    //   - guidance: string (required, < 2000 chars)
    //   - timestamp: timestamp (required)
    //
    // Collection: alerts
    // Document ID: auto-generated
    // Fields:
    //   - message: string (required, < 1000 chars)
    //   - createdBy: string (required, matches auth.uid)
    //   - timestamp: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "ibrahimrabieismail@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isHealthWorker() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'health_worker' ||
        isAdmin()
      );
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['uid', 'name', 'role', 'location', 'state', 'lga', 'ward', 'createdAt']) &&
             hasRequiredFields(['uid', 'name', 'role', 'location', 'state', 'lga', 'ward', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['health_worker', 'parent', 'admin'] &&
             data.location is string && data.location.size() > 0 && data.location.size() < 100 &&
             data.state is string && data.state.size() > 0 && data.state.size() < 100 &&
             data.lga is string && data.lga.size() > 0 && data.lga.size() < 100 &&
             data.ward is string && data.ward.size() > 0 && data.ward.size() < 100 &&
             data.createdAt is timestamp;
    }

    function isValidCase() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['userId', 'patientAgeMonths', 'symptoms', 'riskLevel', 'likelyIllness', 'guidance', 'timestamp']) &&
             hasRequiredFields(['userId', 'patientAgeMonths', 'symptoms', 'riskLevel', 'likelyIllness', 'guidance', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.patientAgeMonths is number && data.patientAgeMonths >= 0 &&
             data.symptoms is string && data.symptoms.size() > 0 && data.symptoms.size() < 1000 &&
             data.riskLevel in ['Low', 'Medium', 'High'] &&
             data.likelyIllness is string && data.likelyIllness.size() > 0 && data.likelyIllness.size() < 200 &&
             data.guidance is string && data.guidance.size() > 0 && data.guidance.size() < 2000 &&
             data.timestamp is timestamp;
    }

    function isValidAlert() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['message', 'createdBy', 'timestamp']) &&
             hasRequiredFields(['message', 'createdBy', 'timestamp']) &&
             data.message is string && data.message.size() > 0 && data.message.size() < 1000 &&
             data.createdBy == request.auth.uid &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow creation if valid. Cannot create admin role unless already an admin.
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser() && (request.resource.data.role != 'admin' || isAdmin());
      // Allow update if valid. Cannot change role unless admin.
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser() && (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /cases/{caseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidCase();
      allow update: if false; // Cases are immutable
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isHealthWorker() && isValidAlert();
      allow update: if false; // Alerts are immutable
      allow delete: if false;
    }
  }
}
