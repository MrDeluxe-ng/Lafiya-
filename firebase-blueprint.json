{
  "entities": {
    "Case": {
      "title": "Case",
      "description": "A triage case",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User who created the case"
        },
        "patientAgeMonths": {
          "type": "number",
          "description": "Age of the patient"
        },
        "symptoms": {
          "type": "string",
          "description": "Reported symptoms"
        },
        "riskLevel": {
          "type": "string",
          "description": "Risk level"
        },
        "likelyIllness": {
          "type": "string",
          "description": "Likely illness"
        },
        "guidance": {
          "type": "string",
          "description": "AI guidance provided"
        },
        "timestamp": {
          "type": "string",
           "description": "Firestore timestamp"
        }
      },
      "required": ["userId", "patientAgeMonths", "symptoms", "riskLevel", "likelyIllness", "guidance", "timestamp"]
    }
  },
  "firestore": {
    "/cases/{caseId}": {
      "schema": {
        "$ref": "#/entities/Case"
      },
      "description": "Triage cases collection"
    }
  }
}
